#include <windows.h>

1 DIALOG 0, 0, 250, 64
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to Server"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
FONT 8, "Tahoma"
{
   CONTROL "Server IP:", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 40, 6, 199, 10 
   CONTROL "", 1001, EDIT, ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 41, 16, 200, 14 
   CONTROL "Connect", 1, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 50, 46, 80, 14 
   CONTROL "Cancel", 2, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 135, 46, 80, 14 
   CONTROL "Format: 192.168.x.x", 0, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 40, 34, 198, 10 
   CONTROL "IDI_PC", 3, STATIC, SS_ICON | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 14, 20, 20 
}
